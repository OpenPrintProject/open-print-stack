# Copy to .env for local development.
DATABASE_URL=postgres://ops:ops@localhost:5432/ops
REDIS_URL=redis://localhost:6379
API_PORT=3000
# Where the web app is opened. The API is served under /api on the same origin.
APP_URL=http://localhost:5173
# Signs sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
